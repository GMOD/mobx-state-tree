{
  "name": "@jbrowse/mobx-state-tree",
  "version": "6.10.0",
  "description": "Fork of mobx-state-tree starting from v5.4.2 for use in jbrowse 2",
  "types": "./dist/index.d.ts",
  "main": "./dist/mobx-state-tree.cjs",
  "module": "./dist/mobx-state-tree.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mobx-state-tree.mjs",
      "require": "./dist/mobx-state-tree.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "clean": "node -e \"for (const d of ['dist', 'lib', 'esm']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "prebuild": "pnpm clean",
    "format": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "build": "tsc && rollup -c",
    "test": "vitest",
    "test:types": "tsc -p __tests__/types/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test-ci": "pnpm test:types && pnpm test:dev --run && pnpm test:prod --run",
    "test:dev": "vitest --mode development",
    "test:prod": "vitest --mode production",
    "bench": "vitest bench --run --mode production",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test-ci",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMOD/mobx-state-tree.git"
  },
  "author": "Michel Weststrate",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "git-cliff": "^2.14.2",
    "mobx": "^7.1.0",
    "prettier": "^3.9.10",
    "rollup": "^4.65.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-sourcemaps2": "^0.5.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "mobx": "^7.0.0"
  },
  "keywords": [
    "mobx",
    "mobx-state-tree",
    "promise",
    "reactive",
    "frp",
    "functional-reactive-programming",
    "state management"
  ],
  "publishConfig": {
    "access": "public"
  }
}
